rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Lectura: solo autenticados
    match /{allPaths=**} {
      allow read: if request.auth != null;
    }

    // Escritura restringida: solo bajo cases/{caseId}/**
    // - Solo usuarios autenticados
    // - Máximo 20 MB por archivo
    // - Solo tipos MIME permitidos (PDF, imágenes comunes, documentos Office)
    match /cases/{caseId}/{allPaths=**} {
      allow write: if request.auth != null
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType.matches(
             'application/pdf'
             + '|image/(jpeg|png|gif|webp|tiff|bmp)'
             + '|application/msword'
             + '|application/vnd\\.openxmlformats-officedocument\\..*'
             + '|application/vnd\\.ms-excel'
             + '|application/vnd\\.ms-powerpoint'
           );
      allow read: if request.auth != null;
    }
  }
}
